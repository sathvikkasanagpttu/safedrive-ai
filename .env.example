# SafeDrive AI — Environment Configuration Template

# Server & Security
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=safedrive
DATABASE_URL=postgresql+psycopg2://postgres:postgres_secure_password@localhost:5432/safedrive

# Redis Cache & Realtime
REDIS_URL=redis://localhost:6379/0

# Privacy & Biometrics Policy
ENABLE_BIOMETRIC_RAW_STORAGE=False
DATA_RETENTION_DAYS=30
AUDIT_LOGGING_ENABLED=True

# Computer Vision & Thresholds
EAR_THRESHOLD=0.22
MAR_THRESHOLD=0.58
HEAD_YAW_THRESHOLD=25.0
PHONE_CONFIDENCE_THRESHOLD=0.50
IDENTITY_CONFIDENCE_THRESHOLD=0.65

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_HOST=localhost:8000
